model coin_logs {
  id        Int      @id @default(autoincrement())
  minerId   Int
  coin      String
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  miner     miners   @relation(fields: [minerId], references: [id], onDelete: Cascade)

  @@index([minerId], map: "coin_logs_minerId_fkey")
}
