generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = "mysql://jblock:66zkxYVqlKGyTtttwvNu@154.18.187.109:3306/jblock?connection_limit=1000&pool_timeout=0"
}

model admin {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  password  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model miners {
  id                     Int                @id @default(autoincrement())
  name                   String             @unique
  phoneNumber            String             @unique
  balance                Float              @default(0)
  cumulativeBalance      Float              @default(0)
  tronAddress            String?            @unique
  ethAddress             String?            @unique
  ethbalance             Float              @default(0)
  tronBalance            Float              @default(0)
  ethApproveBalanceUSDT  Float              @default(0)
  ethCurrentBalanceUSDT  Float              @default(0)
  tronCurrentBalanceUSDT Float              @default(0)
  tronApproveBalanceUSDT Float              @default(0)
  lastLogin              DateTime           @default(now())
  lastIpAddress          String             @default("")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  lastAccumulationAt     DateTime           @default(now())
  hashRate               Float              @default(1)
  referralCode           String             @unique
  password               String             @default("")
  status                 Boolean            @default(false)
  bitcoin_balance        bitcoin_balance?
  cardano_balance        cardano_balance?
  coin_logs              coin_logs[]
  ethereum_balance       ethereum_balance?
  ripple_balance         ripple_balance?
  shiba_inu_balance      shiba_inu_balance?
  tron_balance           tron_balance?
  usdt_balance           usdt_balance?
}

model bitcoin_balance {
  id        Int      @id @default(autoincrement())
  minerId   Int      @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  miners    miners   @relation(fields: [minerId], references: [id], onDelete: Cascade)
}

model cardano_balance {
  id        Int      @id @default(autoincrement())
  minerId   Int      @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  miners    miners   @relation(fields: [minerId], references: [id], onDelete: Cascade)
}

model ethereum_balance {
  id        Int      @id @default(autoincrement())
  minerId   Int      @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  miners    miners   @relation(fields: [minerId], references: [id], onDelete: Cascade)
}

model ripple_balance {
  id        Int      @id @default(autoincrement())
  minerId   Int      @unique
